@model GiftOfTheGivers.Models.Volunteer

@{
    ViewData["Title"] = "Volunteer Registration";
}

<h2>Volunteer Registration</h2>

<form asp-action="Index" method="post">

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Skills"></label>
        <input asp-for="Skills" class="form-control" />
        <span asp-validation-for="Skills" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Availability"></label>
        <select asp-for="Availability" class="form-select">
            <option value="">Select Availability</option>
            <option>Weekdays</option>
            <option>Weekends</option>
            <option>Full Time</option>
            <option>Part Time</option>
        </select>
        <span asp-validation-for="Availability" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Register as Volunteer
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}