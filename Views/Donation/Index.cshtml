@model GiftOfTheGivers.Models.Donation

<h2>Make a Donation</h2>

<form asp-action="Index" method="post">

    <div class="mb-3">
        <label>Your Name</label>
        <input asp-for="DonorName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Amount</label>
        <input asp-for="Amount" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Currency</label>

        <select asp-for="Currency" class="form-select">

            <option>ZAR</option>

            <option>USD</option>

            <option>EUR</option>

        </select>

    </div>

    <div class="mb-3">

        <label>Donation Type</label>

        <select asp-for="DonationType" class="form-select">

            <option>One-Time</option>

            <option>Recurring</option>

        </select>

    </div>

    <button class="btn btn-primary">

        Donate

    </button>

</form>