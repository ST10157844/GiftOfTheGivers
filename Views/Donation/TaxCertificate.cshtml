@model GiftOfTheGivers.Models.TaxCertificateViewModel

@{
    ViewData["Title"] = "Tax Certificate";
}

<div class="container mt-5">

    <div class="card p-4 shadow">

        <h2 class="text-primary">
            Gift of the Givers Foundation
        </h2>

        <h4 class="mt-3">
            Placeholder Tax Certificate
        </h4>

        <hr />

        <p>
            <strong>Certificate Number:</strong>
            @Model.CertificateNumber
        </p>

        <p>
            <strong>Donor:</strong>
            @Model.DonorName
        </p>

        <p>
            <strong>Donation Amount:</strong>
            @Model.Amount @Model.Currency
        </p>

        <p>
            <strong>Donation Type:</strong>
            @Model.DonationType
        </p>

        <p>
            <strong>Issued Date:</strong>
            @Model.IssuedDate.ToString("dd MMMM yyyy HH:mm")
        </p>

        <hr />

        <p class="text-muted">
            Prototype tax certificate generated by the
            Gift of the Givers Azure Function.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Return Home
        </a>
        <p class="text-success">
            Thank you for supporting disaster relief efforts.
        </p>

    </div>

</div>